  "formal_definitions": [
    {
      "id": "D1",
      "name": "Dynamic Conflict Window",
      "statement": "W(c_i, c_j) = 1 − exp(−κ·O·e^(−τ/θ))",
      "status": "defined"
    },
    {
      "id": "D2",
      "name": "Post-Merge Verification Operator",
      "statement": "V(c) = ⊕_V(δ_i, {V(p)}, CI(c_i)) — three-valued: verified, failed, tainted",
      "status": "defined"
    },
    {
      "id": "D3",
      "name": "Auto-Remediation Bound",
      "statement": "P(Remediation) ≥ 1 − (λ_fail/μ_remediate)^K · e^(−γ·T_react)",
      "status": "defined"
    }
  ],
  "propositions": [
    {
      "id": "P1",
      "name": "Admission Independence",
      "statement": "Admission latency is independent of CI duration",
      "status": "proven"
    },
    {
      "id": "P2",
      "name": "Monotonicity of Conflict Window",
      "statement": "W is decreasing in τ and increasing in overlap",
      "status": "proven"
    },
    {
      "id": "P3",
      "name": "Minimum Tier Depth",
      "statement": "K ≥ (ln(1/ε) − γT) / ln(1/ρ)",
      "status": "proven"
    }
  ],
  "architectural_pillars": [
    "Lock-Free Merge Entry",
    "Post-Merge Verification Layer",
    "Proactive Remediation Agents"
  ],
